// -*- mode: jsonc -*-
{
    // General configuration
    // "layer": "top", // Waybar at top layer
    "position": "top", // Waybar position (top|bottom|left|right)
    "height": 24, // Waybar height (to be removed for auto height)
    // "width": 1280, // Waybar width
    "spacing": 10, // Gaps between modules (4px)

    // Module arrangement
    "modules-left": [
        "custom/waybar-watchers",
        "group/actions",
        "group/connectivity",
        "group/power",
        "group/privacy",
        "tray"
    ],
    "modules-center": [
        "hyprland/workspaces",
    ],
    "modules-right": [
        "group/system-stats",
        "clock"
    ],

    // Groups
    "group/actions": {
        "orientation": "horizontal",
        "modules": [
          "custom/updates",
          "custom/swaync"
        ]
    },
    "group/connectivity": {
        "orientation": "horizontal",
        "modules": [
            "network",
            "custom/bluetooth",
            "custom/proton-vpn"
        ]
    },
    "group/power": {
        "orientation": "horizontal",
        "modules": [
            "custom/power-profile", // "power-profiles-daemon",
            "custom/ecstasy" // "idle_inhibitor",
        ]
    },
    "group/privacy": {
        "orientation": "horizontal",
        "modules": [
            "privacy",
            "custom/recording"
        ]
    },
    "group/system-stats": {
        "orientation": "horizontal",
        "modules": [
            "pulseaudio",
            "backlight",
            // "cpu",
            // "memory",
            "temperature",
            "battery"
        ]
    },

    // Built-in modules
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        }
    },
    "tray": {
        // Comments are suggested values for a visible tray
        "icon-size": 1, // 14
        "spacing": 0, // 11
    },
    "privacy": {
        // The privacy module is icon-only; size and spacing are configurable.
        "icon-size": 12,
        "icon-spacing": 0,
        "transition-duration": 0,
        "modules": [
            { "type": "screenshare" },
            { "type": "audio-in" },
            { "type": "location" }
        ]
    },
    "clock": {
        "format": "{:%a %I:%M %p}",
        "format-alt": "{:%a %H:%M}",
        "tooltip-format": "<big>{:%d %B %Y}</big>\n<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "weeks-pos": "none",
            "format": {
                "months": "",
                "days": "<span color='#ffffff'><b>{}</b></span>",
                "weeks": "",
                "weekdays": "<span color='#ffffff'><b>{}</b></span>",
                "today": "<span color='#00ff00'><b>{}</b></span>"
            }
        },
        "interval": 1
    },
    "cpu": {
        "format": "{usage} ",
        "tooltip": false
    },
    "memory": {
        "format": "{} "
    },
    "temperature": {
        // "thermal-zone": 2,
        // "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
        "critical-threshold": 80,
        // "format-critical": "{temperatureC} {icon}",
        "tooltip": false,
        "format": "{temperatureC} {icon}",
        "format-icons": ["", "", "", "", ""]
    },
    "backlight": {
        // "device": "acpi_video1",
        "format": "{percent} {icon}",
        "format-icons": ["", "", "", "", "", "", "", "", ""],
        "tooltip": false
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity} {icon}",
        "format-full": "{capacity} 󰁹",
        "format-charging": "{capacity} {icon}",
        "format-plugged": "{capacity} 󰚥",
        "format-icons": {
            "default": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
            "charging": ["󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"]
        }
    },
    "power-profiles-daemon": {
      "format": "{icon}",
      "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
      "format-icons": {
        "default": "󰾅",
        "performance": "󰓅",
        "balanced": "󰾅",
        "power-saver": "󰾆"
      }
    },
    "network": {
        "format-wifi": "{icon}",
        "format-icons": ["󰤯","󰤟","󰤢","󰤥","󰤨"],
        "format-ethernet": "",
        "format-disconnected": "󰤮",
        "format-linked": "󰤫",

        "tooltip-format-wifi": "{essid} ({signalStrength}%)\nInterface: {ifname} via {gwaddr}\nLocal: {ipaddr}/{cidr}",
        "tooltip-format-ethernet": "Interface: {ifname} via {gwaddr}\nLocal: {ipaddr}/{cidr}",
        "tooltip-format-disconnected": "You are currently not connected to the internet.",
        "tooltip-format-linked": "Interface: {ifname} (No IP)",

        "on-click": "kitty nmtui"
    },
    "pulseaudio": {
        "format": "{volume} {icon}  {format_source}",
        "format-muted": "{volume} {icon}  {format_source}",

        "format-source": "{volume} 󰍬",
        "format-source-muted": "{volume} 󰍭",

        "format-icons": {
            "headphone": "󰋋",
            "hands-free": "󰓃",
            "headset": "󰋎",
            "phone": "󰏲",
            "portable": "󰏲",
            "car": "󰄋",
            "default": [
                "󰕿",
                "󰖀",
                "󰖀",
                "󰕾",
                "󰕾"
            ]
        },
        "on-click": "pavucontrol"
    },

    // Custom modules
    "custom/waybar-watchers": {
        "exec": "~/.config/waybar/scripts/start-watchers.sh",
        "interval": "once",
        "tooltip": false
    },
    "custom/updates": {
        "format": "{}",
        "exec": "~/.config/waybar/scripts/updaters/updates-get.sh",
        "return-type": "json",
        "interval": 600,
        "signal": 1,
        "on-click": "kitty ~/.config/waybar/scripts/workers/updates-install.sh"
    },
    "custom/swaync": {
        "format": "{}",
        "exec": "~/.config/waybar/scripts/updaters/swaync-get.sh",
        "return-type": "json",
        "signal": 2,
        "on-click": "swaync-client -t"
    },
    "custom/bluetooth": {
        "format": "{}",
        "exec": "~/.config/waybar/scripts/updaters/bluetooth-get.sh",
        "return-type": "json",
        "signal": 3,
        "on-click": "blueman-manager"
    },
    "custom/proton-vpn": {
        "format": "{}",
        "exec": "~/.config/waybar/scripts/updaters/proton-vpn-get.sh",
        "return-type": "json",
        "signal": 4,
        "on-click": "protonvpn-app"
    },
    "custom/power-profile": {
        "format": "{}",
        "exec": "~/.config/waybar/scripts/updaters/power-profile-get.sh",
        "return-type": "json",
        "interval": "once",
        "signal": 5,
        "on-click": "~/.config/waybar/scripts/workers/power-profile-toggle.sh"
    },
    "custom/ecstasy": {
        "format": "{}",
        "exec": "~/.config/waybar/scripts/updaters/ecstasy-get.sh",
        "return-type": "json",
        "interval": "once",
        "signal": 6,
        "on-click": "~/.config/waybar/scripts/workers/ecstasy-toggle.sh"
    },
    "custom/recording": {
        "format": "{}",
        "exec": "~/.config/waybar/scripts/updaters/recording-get.sh",
        "return-type": "json",
        "signal": 7,
    },
}
