<?xml version="1.0" encoding="UTF-8"?>
<gamecontroller configversion="19" appversion="3.6.1">
  <sets>
    <set index="1">
      <dpad index="1">
        <!-- dpad left => F23 -->
        <dpadbutton index="2">
          <slots>
            <slot>
              <code>0x1000047</code>
              <mode>keyboard</mode>
            </slot>
          </slots>
        </dpadbutton>

        <!-- dpad right => F24 -->
        <dpadbutton index="8">
          <slots>
            <slot>
              <code>0x1000046</code>
              <mode>keyboard</mode>
            </slot>
          </slots>
        </dpadbutton>
      </dpad>

      <!-- left super => back (code taken from your current file) -->
      <button index="5">
        <slots>
          <slot>
            <code>0x1000022</code>
            <mode>keyboard</mode>
          </slot>
        </slots>
      </button>
    </set>
  </sets>
</gamecontroller>
